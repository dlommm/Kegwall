# Dependencies — reinstalled inside the image (deps/runtime stages each run
# their own `npm ci`; a host-platform node_modules would poison native
# bindings like better-sqlite3 anyway).
node_modules

# Build output — regenerated inside the image by the "web" stage.
dist

# Runtime state — never bake a developer's local DB/uploads into the image;
# production data belongs in the /data volume, not a layer.
data
*.db
*.db-wal
*.db-shm

# VCS / editor / OS cruft.
.git
.gitignore
.DS_Store

# Project process/planning artifacts — not needed to build or run the app.
.superpowers
docs

# Test suites and their artifacts — not needed to build or run the app.
tests
test-results
playwright-report
playwright.config.ts
vitest.config.ts


# Deploy examples themselves aren't build context inputs.
deploy
